# ARM64 image for Raspberry Pi (Pi 3/4/5, 64-bit OS)
# Build with buildx and pass --platform linux/arm64; BuildKit sets the
# target platform for the base images automatically, so no per-FROM override.

# Build stage
FROM node:18-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

# Vite bakes these in at build time. Passed as build args (instead of a .env
# file in the context) to avoid a BuildKit fsutil bug that rejects ".env".
ARG VITE_API_BASE_URL=https://ncs.dotdevz.com
ARG VITE_WS_URL=wss://ncs.dotdevz.com/ws/notifications/
ARG VITE_HOSPITAL_ID=4
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_WS_URL=$VITE_WS_URL \
    VITE_HOSPITAL_ID=$VITE_HOSPITAL_ID
RUN npm run build

# Production stage
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
ENV BACKEND_URL=http://localhost:8000
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
